{
  "name": "@nocobase/app-plugin-tutorial-activity-log",
  "version": "0.1.0",
  "description": "A runnable activity log plugin for the NocoBase plugin development tutorial.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24 <25"
  },
  "prettier": "@nocobase/dev-config/prettier",
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "exports": {
    "./client": {
      "types": "./client/index.ts",
      "import": "./client/index.ts"
    },
    "./client/components": {
      "types": "./client/activity-log.tsx",
      "import": "./client/activity-log.tsx"
    },
    "./client/service": {
      "types": "./client/service.ts",
      "import": "./client/service.ts"
    },
    "./client/preferences": {
      "types": "./client/preferences.ts",
      "import": "./client/preferences.ts"
    },
    "./client/routes": {
      "types": "./client/routes.ts",
      "import": "./client/routes.ts"
    },
    "./server": {
      "types": "./server/index.ts",
      "import": "./server/index.ts"
    },
    "./config": {
      "types": "./server/config.ts",
      "import": "./server/config.ts"
    },
    "./cli": {
      "types": "./cli/index.ts",
      "import": "./cli/index.ts"
    },
    "./contracts": {
      "types": "./shared/contracts.ts",
      "import": "./shared/contracts.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      "./client": {
        "types": "./dist/client/index.d.ts",
        "import": "./dist/client/index.js"
      },
      "./client/components": {
        "types": "./dist/client/activity-log.d.ts",
        "import": "./dist/client/activity-log.js"
      },
      "./client/service": {
        "types": "./dist/client/service.d.ts",
        "import": "./dist/client/service.js"
      },
      "./client/preferences": {
        "types": "./dist/client/preferences.d.ts",
        "import": "./dist/client/preferences.js"
      },
      "./client/routes": {
        "types": "./dist/client/routes.d.ts",
        "import": "./dist/client/routes.js"
      },
      "./server": {
        "types": "./dist/server/index.d.ts",
        "import": "./dist/server/index.js"
      },
      "./config": {
        "types": "./dist/server/config.d.ts",
        "import": "./dist/server/config.js"
      },
      "./cli": {
        "types": "./dist/cli/index.d.ts",
        "import": "./dist/cli/index.js"
      },
      "./contracts": {
        "types": "./dist/shared/contracts.d.ts",
        "import": "./dist/shared/contracts.js"
      },
      "./package.json": "./package.json"
    }
  },
  "peerDependencies": {
    "@nocobase/app-client": "4.0.0-beta.3",
    "@nocobase/app-server": "3.0.0-beta.3",
    "@nocobase/app-cli": "1.0.0-beta.27",
    "@nocobase/app-plugin-authentication": "2.0.0-beta.13",
    "@nocobase/app-plugin-authorization": "1.0.0-beta.31",
    "@nocobase/db": "1.0.0-beta.22",
    "@nocobase/service-provider": "0.0.2-beta.2",
    "@nocobase/i18n": "2.0.0-beta.1",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "react": "19.3.1"
  },
  "dependencies": {
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nocobase/dev-config": "0.1.0-beta.25",
    "@nocobase/app-testing": "0.1.0-beta.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "vite": "6.4.5",
    "jsdom": "30.1.3",
    "react-dom": "19.3.1",
    "react-router": "7.18.4",
    "@nocobase/authorization": "1.0.0-beta.15"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && nocobase-db-manifests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "prepack": "pnpm build"
  }
}
